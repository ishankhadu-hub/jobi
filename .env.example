# =============================================================================
# JOBI — one file to rule them all.
#
# HOW THIS WORKS
#   * This is the ONLY place you ever paste a secret.
#   * No application code reads process.env directly. Everything goes through
#     shared/config.js. To change a provider, edit THIS file — never code.
#   * Copy this file to `.env` and fill in the blanks:  cp .env.example .env
#   * `.env` is git-ignored. `.env.example` (this file) is committed as the
#     template, so keep it blank.
#
# FILL-IN ORDER: see docs/GO_LIVE_CHECKLIST.md. In MOCK_MODE you need NONE of
# the real values below — the app runs end to end with everything blank.
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
# NODE_ENV / APP_ENV: "development" or "production".
# MOCK_MODE only works in development. A production build with MOCK_MODE=true
# REFUSES to start (see shared/config.js -> assertMockModeSafe).
NODE_ENV="development"
APP_ENV="development"

# -----------------------------------------------------------------------------
# MOCK MODE  (build & test the whole app before spending a rupee)
# -----------------------------------------------------------------------------
# true  -> LLM calls return realistic canned responses (no network, no key),
#          uploads write to local disk, subscription checks always pass.
# false -> everything hits the real services (needs the keys below).
MOCK_MODE="true"

# Mock realism knobs — tune these to design your loading & error states.
MOCK_MIN_DELAY_MS="350"          # floor of the simulated "thinking" delay
MOCK_MAX_DELAY_MS="1400"         # ceiling of the simulated delay
MOCK_RATE_LIMIT_RATE="0.06"      # 0.06 = ~6% of calls fake a 429 rate-limit
MOCK_ERROR_RATE="0.0"            # optional: fraction that fake a 500

# -----------------------------------------------------------------------------
# LLM PROVIDER  (OpenAI-compatible shape — swappable from here only)
# -----------------------------------------------------------------------------
# Use a provider with a NO-TRAINING policy on your data. Groq, Together,
# Fireworks, OpenRouter, DeepInfra, etc. all expose an OpenAI-compatible API.
LLM_API_KEY=""                   # paste key from a provider with a no-training policy
LLM_BASE_URL=""                  # e.g. https://api.groq.com/openai/v1
LLM_MODEL=""                     # model name here, e.g. llama-3.3-70b-versatile

# Fallback provider — used automatically if the primary returns 404 (model
# deleted) or 429 (rate limited) and cannot recover. Point it at a DIFFERENT
# provider/model so one vendor pulling a free model doesn't take you down.
LLM_FALLBACK_API_KEY=""          # key for the backup provider (may repeat primary)
LLM_FALLBACK_BASE_URL=""         # e.g. https://api.together.xyz/v1
LLM_FALLBACK_MODEL=""            # backup model name

# LLM tuning (safe defaults; rarely need changing)
LLM_TIMEOUT_MS="45000"
LLM_MAX_RETRIES="2"              # retry/backoff on 429/5xx before falling back

# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
# For local dev with the Supabase CLI (`supabase start`), the CLI prints these.
# For production, copy from your Supabase project's API settings.
SUPABASE_URL=""                  # from your Supabase project settings (or CLI output)
SUPABASE_ANON_KEY=""             # from your Supabase project settings — safe in the app
SUPABASE_SERVICE_KEY=""          # server-side ONLY, never in the app build

# -----------------------------------------------------------------------------
# PADDLE  (subscriptions via external web checkout)
# -----------------------------------------------------------------------------
PADDLE_WEBHOOK_SECRET=""         # from Paddle dashboard -> Notifications -> your endpoint

# -----------------------------------------------------------------------------
# SERVICE WIRING  (defaults are fine for local dev)
# -----------------------------------------------------------------------------
# The gateway holds the config module + secrets and makes the actual LLM calls.
GATEWAY_PORT="5679"
GATEWAY_URL="http://localhost:5679"
# Shared secret n8n/orchestrator send to the gateway so nothing else can call it.
GATEWAY_INTERNAL_TOKEN="dev-internal-token-change-me"

# The orchestrator / n8n webhook host the APP talks to. n8n's default port is
# 5678; the dev-orchestrator (n8n stand-in) listens on the same port so the app
# doesn't care which one is running.
ORCHESTRATOR_PORT="5678"

# Free-tier gate: how many full coaching loops an unpaid user gets.
FREE_TIER_LOOP_LIMIT="1"

# -----------------------------------------------------------------------------
# EXPO APP  (the ONLY thing baked into the mobile build)
# -----------------------------------------------------------------------------
# Everything EXPO_PUBLIC_* is embedded in the client bundle — never put a
# secret here. The app calls n8n/orchestrator webhooks only.
EXPO_PUBLIC_API_URL="http://localhost:5678"
