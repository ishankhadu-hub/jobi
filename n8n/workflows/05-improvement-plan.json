        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst b = $('Webhook').first().json.body || {};\nreturn [{ json: { userId: $json.id, sessionId: b.sessionId } }];"
      }
    },
    {
      "id": "n51",
      "name": "Get session",
