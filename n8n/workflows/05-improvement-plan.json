            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n55",
      "name": "LLM: improvement_plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GATEWAY_URL }}/agent/improvement_plan",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-token",
              "value": "={{ $env.GATEWAY_INTERNAL_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  role: $('Get JD').first().json[0].role_title,\n  company: $('Get JD').first().json[0].company,\n  scores: ($('Get scores').first().json || []).map(s => ({ score: s.score, improvements: s.improvements })),\n  gaps: ($('Get tailored (gaps)').first().json[0] || {}).gaps || []\n}) }}",
        "options": {}
      }
    },
    {
      "id": "n56",
      "name": "Store plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/improvement_plans?on_conflict=session_id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation,resolution=merge-duplicates"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  user_id: $('Read body').first().json.userId,\n  session_id: $('Read body').first().json.sessionId,\n  overall_score: $json.data.overall_score, readiness: $json.data.readiness, summary: $json.data.summary,\n  practise: $json.data.practise || [], answers_to_rework: $json.data.answers_to_rework || [],\n  gaps_to_address: $json.data.gaps_to_address || [], next_step: $json.data.next_step\n}) }}",
        "options": {}
      }
    },
    {
      "id": "n57",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
