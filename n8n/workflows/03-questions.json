        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst b = $('Webhook').first().json.body || {};\nreturn [{ json: { userId: $json.id, jobDescriptionId: b.jobDescriptionId } }];"
      }
    },
    {
      "id": "n27",
      "name": "Get JD",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/job_descriptions?id=eq.{{ $json.jobDescriptionId }}&user_id=eq.{{ $json.userId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n28",
      "name": "LLM: questions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GATEWAY_URL }}/agent/questions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-token",
              "value": "={{ $env.GATEWAY_INTERNAL_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  role: $json[0].role_title, company: $json[0].company,\n  competencies: $json[0].competencies, skills: $json[0].skills\n}) }}",
        "options": {}
      }
    },
    {
      "id": "n29",
      "name": "Flatten to rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst d = $json.data; const p = $('Read body').first().json;\nconst rows = []; let pos = 0;\nfor (const cat of ['behavioural','technical','role_specific'])\n  for (const text of (d[cat] || []))\n    rows.push({ user_id: p.userId, job_description_id: p.jobDescriptionId, category: cat, text, position: pos++ });\nreturn [{ json: { rows, grouped: d } }];"
      }
    },
    {
      "id": "n30",
      "name": "Store questions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/questions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.rows) }}",
        "options": {}
      }
    },
    {
      "id": "n31",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1180,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseBody": "={{ JSON.stringify({ questions: $('Flatten to rows').first().json.grouped, rows: $json }) }}",
        "options": {}
      }
    }
  ],
