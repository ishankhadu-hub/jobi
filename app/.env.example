# -----------------------------------------------------------------------------
# Jobi app — client config. Everything EXPO_PUBLIC_* is embedded in the app
# bundle, so NEVER put a secret here. The app calls n8n/orchestrator webhooks
# only; it holds no LLM key and no Supabase service key.
# -----------------------------------------------------------------------------

# REQUIRED — the n8n / orchestrator webhook host.
EXPO_PUBLIC_API_URL="http://localhost:5678"

# OPTIONAL — set these to use REAL Supabase auth. If left blank, the app uses
# the dev-orchestrator's local auth (so you can run with no Supabase at all).
# The anon key is designed to be public (RLS protects the data), so it's safe
# in the client. Do NOT put the service key here.
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# OPTIONAL — Paddle external checkout URL for the upgrade button.
EXPO_PUBLIC_PADDLE_CHECKOUT_URL=""
